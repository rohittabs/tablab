{
  "name": "tablab",
  "version": "1.0.0",
  "private": true,
  "description": "TabLab: a simple guitar and ukulele tab editor and player for students.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
